<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 默认 INFO，避免高频路径刷日志；可用环境变量 SAKIMQ_LOG_LEVEL（或 -DSAKIMQ_LOG_LEVEL）覆盖 -->
    <logger name="com.arth.sakimq" level="${SAKIMQ_LOG_LEVEL:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>